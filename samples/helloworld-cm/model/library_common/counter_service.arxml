<?xml version='1.0' encoding='utf-8'?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00049.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>CounterInterfaces</SHORT-NAME>
      <ELEMENTS>
        <SERVICE-INTERFACE>
          <SHORT-NAME>CounterService</SHORT-NAME>
          <NAMESPACES>
            <SYMBOL-PROPS>
              <SHORT-NAME>demo</SHORT-NAME>
              <SYMBOL>demo</SYMBOL>
            </SYMBOL-PROPS>
            <SYMBOL-PROPS>
              <SHORT-NAME>counter</SHORT-NAME>
              <SYMBOL>counter</SYMBOL>
            </SYMBOL-PROPS>
          </NAMESPACES>
          <MAJOR-VERSION>1</MAJOR-VERSION>
          <MINOR-VERSION>0</MINOR-VERSION>
          <EVENTS>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>CounterChanged</SHORT-NAME>
              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint32_t</TYPE-TREF>
            </VARIABLE-DATA-PROTOTYPE>
          </EVENTS>
          <METHODS>
            <CLIENT-SERVER-OPERATION>
              <SHORT-NAME>GetCounter</SHORT-NAME>
              <ARGUMENTS>
                <ARGUMENT-DATA-PROTOTYPE>
                  <SHORT-NAME>value</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint32_t</TYPE-TREF>
                  <DIRECTION>OUT</DIRECTION>
                </ARGUMENT-DATA-PROTOTYPE>
              </ARGUMENTS>
            </CLIENT-SERVER-OPERATION>
          </METHODS>
        </SERVICE-INTERFACE>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>CounterSomeipDeployments</SHORT-NAME>
      <ELEMENTS>
        <SOMEIP-SERVICE-INTERFACE-DEPLOYMENT UUID="">
          <SHORT-NAME>CounterService</SHORT-NAME>
          <EVENT-DEPLOYMENTS>
            <SOMEIP-EVENT-DEPLOYMENT>
              <SHORT-NAME>CounterChanged</SHORT-NAME>
              <EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/CounterInterfaces/CounterService/CounterChanged</EVENT-REF>
              <EVENT-ID>0x0001</EVENT-ID>
              <TRANSPORT-PROTOCOL>UDP</TRANSPORT-PROTOCOL>
            </SOMEIP-EVENT-DEPLOYMENT>
          </EVENT-DEPLOYMENTS>
          <METHOD-DEPLOYMENTS>
            <SOMEIP-METHOD-DEPLOYMENT>
              <SHORT-NAME>GetCounter</SHORT-NAME>
              <METHOD-REF DEST="CLIENT-SERVER-OPERATION">/CounterInterfaces/CounterService/GetCounter</METHOD-REF>
              <METHOD-ID>1</METHOD-ID>
              <TRANSPORT-PROTOCOL>UDP</TRANSPORT-PROTOCOL>
            </SOMEIP-METHOD-DEPLOYMENT>
          </METHOD-DEPLOYMENTS>
          <SERVICE-INTERFACE-REF DEST="SERVICE-INTERFACE">/CounterInterfaces/CounterService</SERVICE-INTERFACE-REF>
          <EVENT-GROUPS>
            <SOMEIP-EVENT-GROUP>
              <SHORT-NAME>Eventgroup1</SHORT-NAME>
              <EVENT-GROUP-ID>1</EVENT-GROUP-ID>
              <EVENT-REFS>
                <EVENT-REF DEST="SOMEIP-EVENT-DEPLOYMENT">/CounterSomeipDeployments/CounterService/CounterChanged</EVENT-REF>
              </EVENT-REFS>
            </SOMEIP-EVENT-GROUP>
          </EVENT-GROUPS>
          <SERVICE-INTERFACE-ID>102</SERVICE-INTERFACE-ID>
          <SERVICE-INTERFACE-VERSION>
            <MAJOR-VERSION>1</MAJOR-VERSION>
            <MINOR-VERSION>0</MINOR-VERSION>
          </SERVICE-INTERFACE-VERSION>
        </SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
